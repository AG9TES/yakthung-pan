rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the requesting user has the 'admin' role
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper function to check if user is operating on their own document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // =========================================================================
    // USERS COLLECTION (Document ID == Firebase Auth UID)
    // =========================================================================
    match /users/{userId} {
      // 1. Regular users can read their own document; Admins can read any user document
      allow get: if isOwner(userId) || isAdmin();

      // 2. ONLY Admins can list/query the entire users collection (for dashboard)
      allow list: if isAdmin();

      // 3. On initial sign-up: Authenticated user can create their own doc with role == 'user'
      allow create: if isOwner(userId) &&
        request.resource.data.role == 'user' &&
        request.resource.data.uid == userId;

      // 4. On update: User can update progress, XP, score, and timestamps, but CANNOT change role
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role) || isAdmin();

      // 5. Only Admins can delete user documents
      allow delete: if isAdmin();
    }

    // =========================================================================
    // TELEMETRY & ACTIVITY LOGS (Optional secondary stream for live auditing)
    // =========================================================================
    match /admin_activity_logs/{logId} {
      allow read: if isAdmin();
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // Legacy progress fallback collection
    match /user_progress/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
